{
  "name": "capacitor-installer-source",
  "version": "8.0.0",
  "type": "module",
  "description": "Get the Android package name of the app store or installer that installed your app",
  "main": "dist/plugin.cjs",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "unpkg": "dist/plugin.js",
  "files": [
    "android/src/main/",
    "android/build.gradle",
    "dist/",
    "ios/Sources/",
    "ios/Tests/",
    "Package.swift",
    "CHANGELOG.md",
    "CapacitorInstallerSource.podspec"
  ],
  "author": "Denys Galkin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trinitiwowka/capacitor-installer-source.git"
  },
  "bugs": {
    "url": "https://github.com/trinitiwowka/capacitor-installer-source/issues"
  },
  "homepage": "https://github.com/trinitiwowka/capacitor-installer-source#readme",
  "keywords": [
    "capacitor",
    "plugin",
    "native"
  ],
  "scripts": {
    "verify": "npm run verify:ios && npm run verify:android && npm run verify:web",
    "verify:ios": "npm run verify:ios:spm && npm run verify:ios:cocoapods && npm run test:ios",
    "verify:ios:spm": "xcodebuild build -scheme CapacitorInstallerSource -destination generic/platform=iOS CODE_SIGNING_ALLOWED=NO",
    "verify:ios:cocoapods": "cd ios && pod install && xcodebuild build -workspace Plugin.xcworkspace -scheme Plugin -destination generic/platform=iOS CODE_SIGNING_ALLOWED=NO && cd ..",
    "verify:android": "cd android && ./gradlew clean build test && cd ..",
    "test:android:instrumented": "cd android && ./gradlew connectedDebugAndroidTest && cd ..",
    "test:ios": "xcodebuild test -scheme CapacitorInstallerSource -destination 'platform=iOS Simulator,OS=latest,name=iPhone 16e' CODE_SIGNING_ALLOWED=NO",
    "verify:web": "npm test",
    "test": "npm run build && node --test test/*.test.mjs",
    "lint": "npm run eslint && npm run prettier -- --check && npm run swiftlint -- lint ios/Sources ios/Tests",
    "fmt": "npm run eslint -- --fix && npm run prettier -- --write && npm run swiftlint -- lint --fix --format ios/Sources ios/Tests",
    "eslint": "eslint .",
    "prettier": "prettier \"**/*.{css,html,ts,js,java}\" --plugin=prettier-plugin-java",
    "swiftlint": "node-swiftlint",
    "docgen": "docgen --api CapacitorInstallerSourcePlugin --output-readme README.md --output-json dist/docs.json",
    "build": "npm run clean && npm run docgen && tsc && rollup -c rollup.config.mjs",
    "clean": "rimraf ./dist",
    "watch": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/docgen": "^0.3.1",
    "@capacitor/ios": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@ionic/prettier-config": "^4.0.0",
    "@ionic/swiftlint-config": "^2.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "prettier": "^3.6.2",
    "prettier-plugin-java": "^2.7.7",
    "rimraf": "^6.1.0",
    "rollup": "^4.53.2",
    "swiftlint": "^2.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "peerDependencies": {
    "@capacitor/core": "^8.0.0"
  },
  "prettier": "@ionic/prettier-config",
  "swiftlint": "@ionic/swiftlint-config",
  "capacitor": {
    "ios": {
      "src": "ios"
    },
    "android": {
      "src": "android"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@10.9.2",
  "publishConfig": {
    "access": "public"
  }
}
